{
  "name": "sink-shermatova",
  "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics": "shermatova.shermatova.customers",
    "connection.url": "jdbc:postgresql://${PG_HOST}:${PG_PORT}/${PG_DBNAME}?currentSchema=shermatova_ods",
    "connection.username": "${PG_USER}",
    "connection.password": "${PG_SECRET}",
    "insert.mode": "upsert",
    "primary.key.mode": "record_key",
    "delete.enabled": "true",
    "schema.evolution": "basic",
    "table.name.format": "shermatova_ods.ods_${source.table}",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "true",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true"
  }
}
